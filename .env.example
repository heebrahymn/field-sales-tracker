# Carbon Field Sales Tracker - Environment Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon API Key (Safe for browser client)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Optional: Supabase Project Reference ID (for CLI linking)
# SUPABASE_PROJECT_ID=your-project-ref
